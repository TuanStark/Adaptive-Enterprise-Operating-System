{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@aeos/shared-kernel": ["packages/shared-kernel/src"],
      "@aeos/shared-kernel/*": ["packages/shared-kernel/src/*"],
      "@aeos/errors": ["packages/errors/src"],
      "@aeos/errors/*": ["packages/errors/src/*"],
      "@aeos/logger": ["packages/logger/src"],
      "@aeos/logger/*": ["packages/logger/src/*"],
      "@aeos/config": ["packages/config/src"],
      "@aeos/config/*": ["packages/config/src/*"],
      "@aeos/common": ["packages/common/src"],
      "@aeos/common/*": ["packages/common/src/*"],
      "@aeos/database": ["packages/database/src"],
      "@aeos/database/*": ["packages/database/src/*"],
      "@aeos/event-bus": ["packages/event-bus/src"],
      "@aeos/event-bus/*": ["packages/event-bus/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
