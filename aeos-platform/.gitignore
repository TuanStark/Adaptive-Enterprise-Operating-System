# Dependencies
node_modules/
dist/
.turbo/

# Environment
.env
.env.local
.env.production
*.toml
pnpm-lock.yaml

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test
coverage/

# Build
*.tsbuildinfo

# Prisma
packages/database/prisma/*.db

# Terraform
# Local .terraform directories (provider binaries, downloaded modules — ~800MB each, never commit)
**/.terraform/
**/.terraform.lock.hcl

# Terraform state files (contain secrets — use remote state like S3)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terragrunt cache
**/.terragrunt-cache/

# Terraform crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
# Allow example/template tfvars
!*.tfvars.example
!*.tfvars.template

# Terraform override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform generated backend/provider files (auto-generated by terragrunt)
backend.tf
provider.tf

# Terraform plan output (may contain sensitive data)
*.tfplan
tfplan