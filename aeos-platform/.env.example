# ====================================
# AEOS Platform — Environment Variables
# ====================================
# Copy this file to .env and fill in the values.
# NEVER commit actual secrets to Git.
# On K8s: secrets injected via Kubernetes Secrets / External Secrets.

# ── Application ──
NODE_ENV=development
PORT=3000

# ── Database (Option 1: Direct URL — local dev) ──
DATABASE_URL=postgresql://aeos:aeos_secret@localhost:5433/aeos_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Database (Option 2: Component vars — K8s) ──
# DATABASE_HOST=aeos-pgbouncer
# DATABASE_PORT=5432
# DATABASE_NAME=aeos
# DATABASE_USER=aeos
# DATABASE_PASSWORD=<from-k8s-secret>

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=           # Set in production (ElastiCache / On-prem)
# REDIS_TLS_ENABLED=false   # true for AWS ElastiCache

# ── JWT ──
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# JWT_ISSUER=aeos-platform
# JWT_AUDIENCE=aeos-api

# ── Logging ──
LOG_LEVEL=debug

# ── Object Storage (S3 / MinIO) ──
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=aeos-uploads
# S3_REGION=ap-southeast-1
# S3_USE_IRSA=false          # true on AWS EKS (uses pod IAM role)

# ── Cloudinary ──
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Email (SMTP) ──
# Dev: use Mailhog (docker compose up mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
MAIL_FROM=AEOS Platform <noreply@aeos.local>

# ── Frontend ──
FRONTEND_URL=http://localhost:3001
# CORS_ORIGINS=https://app.aeos.com,https://admin.aeos.com

# ── Observability ──
# METRICS_ENABLED=true
# METRICS_PORT=9090
# TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
