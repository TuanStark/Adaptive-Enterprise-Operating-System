datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  DISABLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  TESTING
  QA
  READY_FOR_RELEASE
  DEPLOYED
  DONE
  CANCELLED
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum TaskLinkType {
  BLOCKS
  DUPLICATES
  RELATES_TO
  CLONES
  CAUSES
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ----------------------------------------------------
// TENANT
// ----------------------------------------------------

model Tenant {
  id        String        @id @default(uuid()) @db.Uuid
  name      String?       @db.VarChar(255)
  slug      String        @unique @db.VarChar(255)
  status    TenantStatus?
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  // Relations
  users               User[]
  organizations       Organization[]
  organizationMembers OrganizationMember[]
  invitations         Invitation[]
  workspaces          Workspace[]
  workspaceMembers    WorkspaceMember[]
  roles               Role[]
  projects            Project[]
  projectMembers      ProjectMember[]
  tasks               Task[]
  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]
  taskLinks           TaskLink[]
  taskHistory         TaskHistory[]
  worklogs            Worklog[]
  taskWatchers        TaskWatcher[]
  projectComponents   ProjectComponent[]
  projectVersions     ProjectVersion[]
  files               File[]
  documents           Document[]
  sprints             Sprint[]
  auditLogs           AuditLog[]
  outboxEvents        OutboxEvent[]
  idempotencyKeys     IdempotencyKey[]
  workflows           Workflow[]
  notifications       Notification[]
  meetings            Meeting[]
  approvalRequests    ApprovalRequest[]
  dynamicForms        DynamicForm[]
  channels            Channel[]
  boardConfigs        BoardConfig[]

  @@map("tenants")
}

// ----------------------------------------------------
// IDENTITY
// ----------------------------------------------------

model User {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  email         String      @unique @db.VarChar(255)
  passwordHash  String?     @map("password_hash") @db.VarChar(255)
  firstName     String?     @map("first_name") @db.VarChar(100)
  lastName      String?     @map("last_name") @db.VarChar(100)
  avatarUrl     String?     @map("avatar_url")
  status        UserStatus?
  emailVerified Boolean?    @default(false) @map("email_verified")
  lastLoginAt   DateTime?   @map("last_login_at")
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  createdBy     String?     @map("created_by") @db.Uuid
  updatedBy     String?     @map("updated_by") @db.Uuid
  deletedAt     DateTime?   @map("deleted_at")

  // Relations
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions            Session[]
  oauthAccounts       OauthAccount[]
  ownedOrganizations  Organization[]       @relation("OrganizationOwner")
  organizationMembers OrganizationMember[]
  ownedWorkspaces     Workspace[]          @relation("WorkspaceOwner")
  workspaceMembers    WorkspaceMember[]
  ownedProjects       Project[]            @relation("ProjectOwner")
  projectMembers      ProjectMember[]
  createdTasks        Task[]               @relation("TaskCreator")
  assignedTasks       Task[]               @relation("TaskAssignee")
  reportedTasks       Task[]               @relation("TaskReporter")
  taskComments        TaskComment[]
  taskHistoryActions  TaskHistory[]         @relation("TaskHistoryActor")
  worklogs            Worklog[]            @relation("WorklogAuthor")
  watchedTasks        TaskWatcher[]        @relation("TaskWatcher")
  ownedDocuments      Document[]           @relation("DocumentOwner")
  auditLogs           AuditLog[]           @relation("Actor")
  notifications       Notification[]
  organizedMeetings   Meeting[]            @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]
  channelMemberships    ChannelMember[]
  chatMessages          ChatMessage[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  revoked      Boolean?  @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OauthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  provider          String?  @db.VarChar(50)
  providerAccountId String?  @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_accounts")
}

// ----------------------------------------------------
// ORGANIZATION
// ----------------------------------------------------

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  name      String?   @db.VarChar(255)
  ownerId   String?   @map("owner_id") @db.Uuid
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant     Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User?                @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members    OrganizationMember[]
  workspaces Workspace[]

  @@index([tenantId])
  @@map("organizations")
}

model OrganizationMember {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  role           String?   @db.VarChar(50)
  joinedAt       DateTime? @map("joined_at")

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  email          String?   @db.VarChar(255)
  token          String?   @db.VarChar(255)
  status         String?   @db.VarChar(30)
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ----------------------------------------------------
// WORKSPACE
// ----------------------------------------------------

model Workspace {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String?          @map("tenant_id") @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  name           String?          @db.VarChar(255)
  description    String?
  ownerId        String?          @map("owner_id") @db.Uuid
  status         WorkspaceStatus?
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  createdBy      String?          @map("created_by") @db.Uuid
  updatedBy      String?          @map("updated_by") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at")

  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?             @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members      WorkspaceMember[]
  roles        Role[]
  projects     Project[]
  tasks        Task[]
  taskLinks    TaskLink[]
  taskHistory  TaskHistory[]
  worklogs     Worklog[]
  taskWatchers TaskWatcher[]
  projectComponents ProjectComponent[]
  projectVersions   ProjectVersion[]
  documents    Document[]
  workflows    Workflow[]
  meetings     Meeting[]
  approvalRequests ApprovalRequest[]
  dynamicForms   DynamicForm[]
  boardConfigs   BoardConfig[]

  @@unique([organizationId, name])
  @@index([tenantId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  roleId      String?   @map("role_id") @db.Uuid
  joinedAt    DateTime? @map("joined_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ----------------------------------------------------
// RBAC
// ----------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  name        String?  @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceMembers WorkspaceMember[]
  permissions      RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  resource String @db.VarChar(100)
  action   String @db.VarChar(100)

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------
// PROJECT
// ----------------------------------------------------

model Project {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String?        @map("tenant_id") @db.Uuid
  workspaceId String?        @map("workspace_id") @db.Uuid
  name        String?        @db.VarChar(255)
  description String?
  ownerId     String?        @map("owner_id") @db.Uuid
  status      ProjectStatus?
  priority    Priority?
  startDate   DateTime?      @map("start_date") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  createdBy   String?        @map("created_by") @db.Uuid
  updatedBy   String?        @map("updated_by") @db.Uuid
  deletedAt   DateTime?      @map("deleted_at")

  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?           @relation("ProjectOwner", fields: [ownerId], references: [id])
  members    ProjectMember[]
  sprints    Sprint[]
  tasks      Task[]
  components ProjectComponent[]
  versions     ProjectVersion[]
  boardConfig  BoardConfig?

  @@index([tenantId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("projects")
}

model ProjectMember {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  projectId String?   @map("project_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  role      String?   @db.VarChar(50)
  joinedAt  DateTime? @map("joined_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ----------------------------------------------------
// SPRINT
// ----------------------------------------------------

model Sprint {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  projectId String?   @map("project_id") @db.Uuid
  name      String?   @db.VarChar(255)
  goal      String?
  status    String?   @db.VarChar(30)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@map("sprints")
}

// ----------------------------------------------------
// TASK MANAGEMENT
// ----------------------------------------------------

model Task {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String?     @map("tenant_id") @db.Uuid
  workspaceId       String?     @map("workspace_id") @db.Uuid
  projectId         String?     @map("project_id") @db.Uuid
  key               String      @unique @db.VarChar(50)
  sprintId          String?     @map("sprint_id") @db.Uuid
  parentTaskId      String?     @map("parent_task_id") @db.Uuid
  title             String?     @db.VarChar(255)
  description       String?
  type              TaskType    @default(TASK)
  creatorId         String?     @map("creator_id") @db.Uuid
  reporterId        String?     @map("reporter_id") @db.Uuid
  assigneeId        String?     @map("assignee_id") @db.Uuid
  status            TaskStatus?
  priority          Priority?
  resolution        String?     @db.VarChar(50)
  labels            String[]    @default([])
  storyPoints       Int?        @map("story_points")
  originalEstimate  Int?        @map("original_estimate")
  remainingEstimate Int?        @map("remaining_estimate")
  timeSpent         Int         @default(0) @map("time_spent")
  boardPosition     Float       @default(0) @map("board_position")
  startDate         DateTime?   @map("start_date")
  dueDate           DateTime?   @map("due_date")
  environment       String?     @db.VarChar(100)
  fixVersionId      String?     @map("fix_version_id") @db.Uuid
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  createdBy         String?     @map("created_by") @db.Uuid
  updatedBy         String?     @map("updated_by") @db.Uuid
  deletedAt         DateTime?   @map("deleted_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentTask  Task?            @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks    Task[]           @relation("SubTasks")
  creator     User?            @relation("TaskCreator", fields: [creatorId], references: [id])
  reporter    User?            @relation("TaskReporter", fields: [reporterId], references: [id])
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  fixVersion  ProjectVersion?  @relation(fields: [fixVersionId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments TaskAttachment[]
  sourceLinks TaskLink[]       @relation("SourceLinks")
  targetLinks TaskLink[]       @relation("TargetLinks")
  history     TaskHistory[]
  worklogs    Worklog[]
  watchers    TaskWatcher[]
  components  TaskComponent[]

  @@index([tenantId])
  @@index([workspaceId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, status])
  @@index([projectId])
  @@index([projectId, boardPosition])
  @@index([sprintId])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([reporterId])
  @@index([fixVersionId])
  @@map("tasks")
}

model TaskComment {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  taskId     String?   @map("task_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  content    String?
  isInternal Boolean   @default(false) @map("is_internal")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  tenant  Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task    Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies TaskComment[] @relation("CommentReplies")

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  fileId    String?  @map("file_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("task_attachments")
}

model TaskLink {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String?      @map("tenant_id") @db.Uuid
  workspaceId  String?      @map("workspace_id") @db.Uuid
  sourceTaskId String       @map("source_task_id") @db.Uuid
  targetTaskId String       @map("target_task_id") @db.Uuid
  linkType     TaskLinkType @map("link_type")
  createdAt    DateTime     @default(now()) @map("created_at")
  createdBy    String?      @map("created_by") @db.Uuid

  tenant     Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceTask Task       @relation("SourceLinks", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask Task       @relation("TargetLinks", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId, linkType])
  @@index([workspaceId])
  @@index([sourceTaskId])
  @@index([targetTaskId])
  @@map("task_links")
}

model TaskHistory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  field       String   @db.VarChar(100)
  oldValue    String?  @map("old_value") @db.Text
  newValue    String?  @map("new_value") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User       @relation("TaskHistoryActor", fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([taskId, createdAt])
  @@index([taskId, field])
  @@map("task_history")
}

model Worklog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  timeSpent   Int
  startDate   DateTime @map("start_date") @db.Date
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User       @relation("WorklogAuthor", fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, userId])
  @@index([taskId])
  @@index([userId, startDate])
  @@map("task_worklogs")
}

model TaskWatcher {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User       @relation("TaskWatcher", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([workspaceId])
  @@map("task_watchers")
}

model ProjectComponent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  leadId      String?  @map("lead_id") @db.Uuid

  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskComponent[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@map("project_components")
}

model TaskComponent {
  taskId      String @map("task_id") @db.Uuid
  componentId String @map("component_id") @db.Uuid

  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  component ProjectComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([taskId, componentId])
  @@map("task_components")
}

model ProjectVersion {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  startDate   DateTime? @map("start_date") @db.Date
  releaseDate DateTime? @map("release_date") @db.Date
  isReleased  Boolean   @default(false) @map("is_released")
  isArchived  Boolean   @default(false) @map("is_archived")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@map("project_versions")
}

// ----------------------------------------------------
// BOARD CONFIGURATION
// ----------------------------------------------------

model BoardConfig {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String   @unique @map("project_id") @db.Uuid
  name        String   @default("Board") @db.VarChar(100)
  columns     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("board_configs")
}

// ----------------------------------------------------
// DOCUMENT MANAGEMENT
// ----------------------------------------------------

model File {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  storageProvider String?  @map("storage_provider") @db.VarChar(50)
  storageKey      String?  @map("storage_key")
  fileName        String?  @map("file_name") @db.VarChar(255)
  mimeType        String?  @map("mime_type") @db.VarChar(100)
  size            BigInt?
  uploadedBy      String?  @map("uploaded_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskAttachments TaskAttachment[]

  @@map("files")
}

model Document {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  name        String?   @db.VarChar(255)
  ownerId     String?   @map("owner_id") @db.Uuid
  visibility  String?   @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?             @relation("DocumentOwner", fields: [ownerId], references: [id])
  versions  DocumentVersion[]

  @@map("documents")
}

// ----------------------------------------------------
// MEETING & CALENDAR
// ----------------------------------------------------

model Meeting {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  title       String?   @db.VarChar(255)
  description String?
  startTime   DateTime? @map("start_time")
  endTime     DateTime? @map("end_time")
  meetingUrl  String?   @map("meeting_url")
  organizerId String?   @map("organizer_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant      Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizer   User?                @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  participants MeetingParticipant[]

  @@index([tenantId])
  @@index([workspaceId])
  @@map("meetings")
}

model MeetingParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String?  @map("meeting_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  status    String?  @db.VarChar(30) // PENDING, ACCEPTED, DECLINED
  createdAt DateTime @default(now()) @map("created_at")

  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_participants")
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String?  @map("document_id") @db.Uuid
  versionNumber Int?     @map("version_number")
  fileId        String?  @map("file_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

// ----------------------------------------------------
// NOTIFICATION
// ----------------------------------------------------

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String?  @db.VarChar(100)
  title     String?  @db.VarChar(255)
  content   String?
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId, read])
  @@map("notifications")
}

// ----------------------------------------------------
// AUDIT
// ----------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String?  @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ----------------------------------------------------
// EVENT OUTBOX
// ----------------------------------------------------

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String?      @map("tenant_id") @db.Uuid
  aggregateType String?      @map("aggregate_type") @db.VarChar(100)
  aggregateId   String?      @map("aggregate_id") @db.Uuid
  eventType     String?      @map("event_type") @db.VarChar(100)
  payload       Json?
  status        EventStatus?
  retryCount    Int?         @default(0) @map("retry_count")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("outbox_events")
}

// ----------------------------------------------------
// IDEMPOTENCY
// ----------------------------------------------------

model IdempotencyKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  key         String?   @db.VarChar(255)
  requestHash String?   @map("request_hash") @db.VarChar(255)
  response    Json?
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("idempotency_keys")
}

// ----------------------------------------------------
// WORKFLOW ENGINE
// ----------------------------------------------------

model Workflow {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  name        String?  @db.VarChar(255)
  status      String?  @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rules     WorkflowRule[]

  @@map("workflows")
}

model WorkflowRule {
  id            String  @id @default(uuid()) @db.Uuid
  workflowId    String? @map("workflow_id") @db.Uuid
  triggerEvent  String? @map("trigger_event") @db.VarChar(100)
  actionType    String? @map("action_type") @db.VarChar(100)
  configuration Json?

  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_rules")
}

// ----------------------------------------------------
// APPROVAL WORKFLOW
// ----------------------------------------------------

model ApprovalRequest {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  requesterId String?  @map("requester_id") @db.Uuid
  title       String?  @db.VarChar(255)
  status      String?  @db.VarChar(30) // PENDING, APPROVED, REJECTED, CANCELLED
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps     ApprovalStep[]

  @@index([tenantId])
  @@map("approval_requests")
}

model ApprovalStep {
  id                String   @id @default(uuid()) @db.Uuid
  approvalRequestId String?  @map("approval_request_id") @db.Uuid
  reviewerId        String?  @map("reviewer_id") @db.Uuid
  status            String?  @db.VarChar(30) // PENDING, APPROVED, REJECTED
  comment           String?
  stepOrder         Int      @map("step_order") @default(1)
  actedAt           DateTime? @map("acted_at")
  createdAt         DateTime @default(now()) @map("created_at")

  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@map("approval_steps")
}

// ----------------------------------------------------
// FORM BUILDER
// ----------------------------------------------------

model DynamicForm {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  name        String?  @db.VarChar(255)
  description String?
  schema      Json?    // JSON Schema describing the form fields
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([tenantId])
  @@map("dynamic_forms")
}

model FormSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  formId      String?  @map("form_id") @db.Uuid
  submitterId String?  @map("submitter_id") @db.Uuid
  data        Json?    // The submitted data matching the schema
  createdAt   DateTime @default(now()) @map("created_at")

  form DynamicForm? @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_submissions")
}

// ----------------------------------------------------
// MESSAGING / CHAT
// ----------------------------------------------------

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
}

enum ChannelMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Channel {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  name        String      @db.VarChar(100)
  type        ChannelType @default(PUBLIC)
  description String?
  topic       String?     @db.VarChar(250)
  isArchived  Boolean     @default(false) @map("is_archived")
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members  ChannelMember[]
  messages ChatMessage[]

  @@index([tenantId])
  @@map("channels")
}

model ChannelMember {
  id        String            @id @default(uuid()) @db.Uuid
  channelId String            @map("channel_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      ChannelMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now()) @map("joined_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
  @@map("channel_members")
}

model ChatMessage {
  id              String    @id @default(uuid()) @db.Uuid
  channelId       String    @map("channel_id") @db.Uuid
  senderId        String    @map("sender_id") @db.Uuid
  content         String
  parentMessageId String?   @map("parent_message_id") @db.Uuid
  isPinned        Boolean   @default(false) @map("is_pinned")
  isEdited        Boolean   @default(false) @map("is_edited")
  editedAt        DateTime? @map("edited_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  channel       Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender        User             @relation(fields: [senderId], references: [id])
  parentMessage ChatMessage?     @relation("ThreadReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies       ChatMessage[]    @relation("ThreadReplies")
  reactions     MessageReaction[]

  @@index([channelId, createdAt])
  @@index([parentMessageId])
  @@map("chat_messages")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}
